#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

[ "${3:-/}" = / ] || {
    echo "pam_watchid: installation on another target volume is not supported." >&2
    exit 1
}
# Intel may omit ARM-specific sysctls. A translated x86_64 process still runs on arm64.
process_arch=$(/usr/bin/uname -m) || {
    echo "pam_watchid: cannot query process architecture." >&2
    exit 1
}
case "$process_arch" in
    arm64) physical_arch=arm64 ;;
    x86_64)
        # -i treats an absent proc_translated key as native Intel, but not other errors.
        translated=$(/usr/sbin/sysctl -in sysctl.proc_translated) || {
            echo "pam_watchid: cannot query process translation state." >&2
            exit 1
        }
        case "$translated" in
            1) physical_arch=arm64 ;;
            0|'') physical_arch=x86_64 ;;
            *) echo "pam_watchid: cannot identify physical hardware." >&2; exit 1 ;;
        esac
        ;;
    *) echo "pam_watchid: cannot identify physical hardware." >&2; exit 1 ;;
esac
[ "$physical_arch" = "@ARCH@" ] || {
    echo "pam_watchid: this package does not match the physical Mac architecture." >&2
    exit 1
}
version=$(/usr/bin/sw_vers -productVersion) || exit 1
major=${version%%.*}
case "$major:$physical_arch" in
    15:arm64|15:x86_64|26:arm64|26:x86_64|27:arm64) ;;
    *) echo "pam_watchid: unsupported macOS/hardware combination." >&2; exit 1 ;;
esac

# Embed the standalone uninstaller's read-only safety check; never activate PAM.
set -- --check
@UNINSTALL_SCRIPT@
