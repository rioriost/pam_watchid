#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

[ "${3:-/}" = / ] || {
    echo "pam_watchid: installation on another target volume is not supported." >&2
    exit 1
}

@PAM_CONFIG@

pam_init
install_token="@VERSION@:@ARCH@"
pam_complete_install "$install_token" "@MODULE_SHA256@" "@HELPER_SHA256@"
